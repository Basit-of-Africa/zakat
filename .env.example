# Copy to .env.local (never commit .env.local). Every setting is optional:
# with none of them, Zakat Kit runs fully on each person's device.

# Accounts. Set a MongoDB connection string to turn on accounts and encrypted
# backup. Without it, accounts are on in development (an in-memory store that
# forgets on restart) and off in production, where the sign-up page says so.
MONGODB_URI=
ZAKAT_DB_NAME=zakat_kit
# A long random string. Keeps the sign-in salts of unknown emails stable, so the
# sign-in form cannot be used to find out who has an account.
ACCOUNT_SECRET=

# Optional: connecting a Nigerian bank account through Mono, instead of
# importing statements. Leave empty to offer statement import only.
NEXT_PUBLIC_MONO_PUBLIC_KEY=
MONO_SECRET_KEY=
MONO_API_BASE=
